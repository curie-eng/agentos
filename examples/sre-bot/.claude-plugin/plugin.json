{
  "name": "sre-bot",
  "version": "0.1.0",
  "description": "SRE triage assistant for plain-English production health and Kubernetes questions in Slack. One pinned upstream Kubernetes MCP connector exposes the core toolset: reads execute immediately, six mutations require a fresh human approval, and unmatched tools fail closed. Kubernetes RBAC limits writes to disposable demo-namespace workloads and independently excludes credentials, identity, RBAC, cluster-scoped mutation, and platform upgrades.",
  "license": "Apache-2.0",
  "author": {
    "name": "CurieTech"
  },
  "keywords": [
    "sre",
    "observability",
    "grafana",
    "loki",
    "prometheus",
    "pyroscope",
    "kubernetes",
    "k8s",
    "cluster",
    "triage",
    "approval-gated"
  ],
  "starterPrompts": [
    "Is anything broken right now?",
    "Is any pod crashlooping or restarting?",
    "Are all the nodes healthy?",
    "Did anything get OOMKilled today?",
    "Are there any alerts firing?",
    "Which services are logging the most errors today?",
    "Is the API slow right now?",
    "Show me slow traces from the last hour"
  ],
  "approvalPolicy": {
    "gates": [
      {
        "gate": "mcp__self-upgrade__upgrade_self",
        "route": "sre-approvals"
      },
      {
        "gate": "mcp__self-upgrade__upgrade_platform",
        "route": "sre-approvals"
      }
    ]
  },
  "toolPolicy": {
    "enforcement": "curie/mcp-tool-policy@1",
    "allow": [
      "kubernetes/events_list",
      "kubernetes/namespaces_list",
      "kubernetes/projects_list",
      "kubernetes/nodes_log",
      "kubernetes/nodes_stats_summary",
      "kubernetes/nodes_top",
      "kubernetes/pods_list",
      "kubernetes/pods_list_in_namespace",
      "kubernetes/pods_get",
      "kubernetes/pods_top",
      "kubernetes/pods_log",
      "kubernetes/resources_list",
      "kubernetes/resources_get",
      "self-upgrade/upgrade_self",
      "self-upgrade/upgrade_platform"
    ],
    "approvalRequired": [
      "kubernetes/pods_delete",
      "kubernetes/pods_exec",
      "kubernetes/pods_run",
      "kubernetes/resources_create_or_update",
      "kubernetes/resources_delete",
      "kubernetes/resources_scale"
    ],
    "deny": []
  }
}
