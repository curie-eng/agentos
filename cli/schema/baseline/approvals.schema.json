{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/approvals/v2.1.json",
  "title": "curie <tier> approvals --json",
  "description": "The agent-facing payload of `curie <tier> approvals <agent>`: the dry-run plan; the gate list (`manifest_unreadable` non-null when the deployed manifest could not be read); the pending approval records (`truncated` true when the server page cap was hit); a single resolved record; one-time operator-principal or console-login-code delivery; or the agent's approval route bindings. Each binding separates its verified interactive Slack `resolution`, optional text-only `notification`, and optional `approvers` authority.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    },
    "approvalRecord": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "route": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "granted_tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "resolved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "card_channel": {
          "description": "The channel the approval card was posted to, or null on an older row or a direct API write that omitted the field. The CLI uses the authenticated card channel in its resolve hint; resolver identity and channel are derived from the authenticated principal and are never asserted as request fields.\n\nOPTIONAL, and the only optional property in this record, which is deliberate rather than an oversight. Every sibling was required at birth, when no compatibility question existed. ADR-0101 prefers optional for a property added later: a consumer can tolerate its absence in a payload from an older CLI, which keeps this a MINOR bump. Making it required would reject those older payloads and cost a major version for no gain.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "author",
        "route",
        "gate_kind",
        "granted_tool",
        "status",
        "conversation_id",
        "summary",
        "expires_at",
        "resolved_by"
      ]
    },
    "approvalRouteBinding": {
      "type": "object",
      "additionalProperties": false,
      "description": "One route's display binding. `resolution` is the single verified interactive Slack card; `notification` is an optional text-only ping carrying no resolving affordance; `approvers` is WHO may act, and its absence means the resolution card channel's members are the approvers.",
      "properties": {
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "address": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address"
          ]
        },
        "notification": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string"
            },
            "address": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "address"
          ]
        },
        "approvers": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "group": {
              "type": [
                "string",
                "null"
              ]
            },
            "users": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "resolution"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "gated_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manifest_unreadable": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent",
        "gated_tools",
        "manifest_unreadable"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "pending": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/approvalRecord"
          }
        },
        "count": {
          "type": "integer"
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "agent",
        "pending",
        "count",
        "truncated"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resolved": {
          "$ref": "#/$defs/approvalRecord"
        }
      },
      "required": [
        "resolved"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operator_principal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "token": {"type": "string"},
            "subject": {"type": "string"},
            "expires_at": {"type": "string"}
          },
          "required": ["token", "subject", "expires_at"]
        }
      },
      "required": ["operator_principal"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "console_login_code": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {"type": "string"},
            "subject": {"type": "string"},
            "expires_at": {"type": "string"}
          },
          "required": ["code", "subject", "expires_at"]
        }
      },
      "required": ["console_login_code"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agent": {
          "type": "string"
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/approvalRouteBinding"
          }
        },
        "count": {
          "type": "integer"
        }
      },
      "required": [
        "agent",
        "routes",
        "count"
      ]
    }
  ]
}
