{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/github-app/v1.json",
  "title": "curie cluster github-app --json",
  "description": "The agent-facing payload of `curie cluster github-app` (ADR-0092): the dry-run plan, or whether the platform now holds a GitHub App identity. Never carries the App id or any key material.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "github_app_configured": {
          "type": "boolean"
        }
      },
      "required": [
        "github_app_configured"
      ]
    }
  ]
}
