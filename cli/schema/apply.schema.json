{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.curietech.ai/cli/apply/v1.json",
  "title": "curie apply --json",
  "description": "The agent-facing payload of `curie apply`: the dry-run plan, or the installation the file converged the cluster to. One object per invocation even though apply drives two underlying verbs.",
  "$defs": {
    "dryRun": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "const": true
        },
        "plan": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "dry_run",
        "plan"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/dryRun"
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applied": {
          "const": true
        },
        "namespace": {
          "type": "string"
        },
        "release": {
          "type": "string"
        },
        "comms": {
          "type": "boolean",
          "description": "Whether the file declared comms.slack, so apply configured it as its second phase."
        }
      },
      "required": [
        "applied",
        "namespace",
        "release",
        "comms"
      ]
    }
  ]
}
